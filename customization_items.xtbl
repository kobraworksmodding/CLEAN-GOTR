				<Default>0</Default>
				</Element>
			<Element>
				<Name>Mesh_Variant_Info</Name>
				<Type>Element</Type>
				<Display_Name>Mesh Variants Information</Display_Name>
				<Description>Mesh variant specific information.</Description>
				<Element>
					<Name>Variant_Name</Name>
					<Type>String</Type>
