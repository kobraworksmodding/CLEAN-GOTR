<TableDescription>
	<Name>Customization_Item</Name>
	<Type>TableDescription</Type>
	<Element>
		<Name>Name</Name>
		<Type>String</Type>
		<Description>Name of the customization item slot.</Description>
		</Element>
	<Element>
		<Name>ID</Name>
		<Type>Int</Type>
		<Display_Name>Customization ID</Display_Name>
		<Description>Unique ID for this customization item.</Description>
		<Default>0</Default>
		</Element>
	<Element>
		<Name>DisplayName</Name>
		<Type>Reference</Type>
		<Display_Name>Display Name</Display_Name>
		<Description>Display name for the base item.</Description>
		<Reference>
			<File>localized_exports\CustItem.xtbl</File>
			<Type>CustItem_Identifier.Name</Type>
			<OpenSeparate>False</OpenSeparate>
			</Reference>
		</Element>
	<Element>
		<Name>Slot</Name>
		<Type>Reference</Type>
		<Description>Customization slot that this item belongs to.</Description>
		<Reference>
			<File>customization_slots.xtbl</File>
			<Type>Slot.Name</Type>
			<OpenSeparate>False</OpenSeparate>
			</Reference>
		</Element>
	<Element>
		<Name>Multi_Slot</Name>
		<Type>Element</Type>
		<Display_Name>Multi Slot Information</Display_Name>
		<Required>false</Required>
		<Element>
			<Name>First_Slot</Name>
			<Type>Reference</Type>
			<Display_Name>First Slot</Display_Name>
			<Description>First slot to use for memory.</Description>
			<Reference>
				<File>customization_slots.xtbl</File>
				<Type>Slot.Name</Type>
				<OpenSeparate>False</OpenSeparate>
				</Reference>
			</Element>
		<Element>
			<Name>Last_Slot</Name>
			<Type>Reference</Type>
			<Display_Name>Last Slot</Display_Name>
			<Description>Last slot to use for memory.</Description>
			<Reference>
				<File>customization_slots.xtbl</File>
				<Type>Slot.Name</Type>
				<OpenSeparate>False</OpenSeparate>
				</Reference>
			</Element>
		</Element>
	<Element>
		<Name>Base_Respect_Bonus</Name>
		<Type>Int</Type>
		<Display_Name>Base Respect Bonus</Display_Name>
		<Description>Respect bonus to be used for all variants.  Setting this value will cause any variant respect bonuses to be ignored by the game.</Description>
		<Default>0</Default>
		</Element>
	<Element>
		<Name>Base_Price</Name>
		<Type>Int</Type>
		<Display_Name>Base Price</Display_Name>
		<Default>0</Default>
		</Element>
	<Element>
		<Name>Flags</Name>
		<Type>Flags</Type>
		<Flag>use hair length slider</Flag>
		<Flag>not ready</Flag>
		<Flag>big hat</Flag>
		</Element>
	<Element>
		<Name>Wear_Options</Name>
		<Type>Grid</Type>
		<Display_Name>Wear Options</Display_Name>
		<Description>Wear options for this item.</Description>
		<Element>
			<Name>Wear_Option</Name>
			<Type>Element</Type>
			<Display_Name>Wear Option</Display_Name>
			<Element>
				<Name>Name</Name>
				<Type>Reference</Type>
				<Description>Name of the wear option.</Description>
				<Reference>
					<File>localized_exports\CustWear.xtbl</File>
					<Type>CustWear_Identifier.Name</Type>
					<OpenSeparate>False</OpenSeparate>
					</Reference>
				</Element>
			<Element>
				<Name>disabled</Name>
				<Type>Selection</Type>
				<Default>no</Default>
				<Choice>no</Choice>
				<Choice>yes</Choice>
				</Element>
			<Element>
				<Name>Active_Flags</Name>
				<Type>Grid</Type>
				<Display_Name>Active Flags</Display_Name>
				<Element>
					<Name>Active_Flag</Name>
					<Type>Element</Type>
					<Display_Name>Active Flag</Display_Name>
					<Element>
						<Name>Flag</Name>
						<Type>Reference</Type>
						<Description>Flag that is active while this item is being worn.</Description>
						<Reference>
							<File>customization_flags.xtbl</File>
							<Type>Flag.Name</Type>
							<OpenSeparate>False</OpenSeparate>
							</Reference>
						</Element>
					<Element>
						<Name>Comparison</Name>
						<Type>Selection</Type>
						<Description>Valid for comparing when switching wear options.</Description>
						<Default>yes</Default>
						<Choice>yes</Choice>
						<Choice>no</Choice>
						</Element>
					</Element>
				<Num_Display_Rows>8</Num_Display_Rows>
				</Element>
			<Element>
				<Name>Required_Flags</Name>
				<Type>Grid</Type>
				<Display_Name>Required Flags</Display_Name>
				<Description>Flags that are required in order for this item to be worn.</Description>
				<Element>
					<Name>Required_Flag</Name>
					<Type>Element</Type>
					<Display_Name>Required Flag</Display_Name>
					<Element>
						<Name>Flag</Name>
						<Type>Reference</Type>
						<Reference>
							<File>customization_flags.xtbl</File>
							<Type>Flag.Name</Type>
							<OpenSeparate>False</OpenSeparate>
							</Reference>
						</Element>
					</Element>
				<Num_Display_Rows>8</Num_Display_Rows>
				</Element>
			<Element>
				<Name>Incompatible_Flags</Name>
				<Type>Grid</Type>
				<Display_Name>Incompatible Flags</Display_Name>
				<Description>Flags that invalidate wearing this item.</Description>
				<Element>
					<Name>Incompatible_Flag</Name>
					<Type>Element</Type>
					<Display_Name>Incompatible Flag</Display_Name>
					<Element>
						<Name>Flag</Name>
						<Type>Reference</Type>
						<Reference>
							<File>customization_flags.xtbl</File>
							<Type>Flag.Name</Type>
							<OpenSeparate>False</OpenSeparate>
							</Reference>
						</Element>
					</Element>
				<Num_Display_Rows>8</Num_Display_Rows>
				</Element>
			<Element>
				<Name>Mesh_Information</Name>
				<Type>Element</Type>
				<Display_Name>Mesh Information</Display_Name>
				<Element>
					<Name>MeshID</Name>
					<Type>Int</Type>
					<Description>Corresponding mesh ID from the player_cust table.</Description>
					<Default>0</Default>
					</Element>
				<Element>
					<Name>Mesh_Filename</Name>
					<Type>Filename</Type>
					<Display_Name>Mesh</Display_Name>
					<Description>Name of the mesh file.</Description>
					<Extension>cmeshx</Extension>
					<Extension>cmesh_pc</Extension>
					<Extension>cmesh_xbox2</Extension>
					<Extension>peg_pc</Extension>
					<Extension>peg_xbox2</Extension>
					<StartingPath>data</StartingPath>
					<ShowPreload>False</ShowPreload>
					</Element>
				<Element>
					<Name>Morph_Filename</Name>
					<Type>Filename</Type>
					<Display_Name>Morph</Display_Name>
					<Description>Name of the morph file.</Description>
					<Required>false</Required>
					<Extension>morphx</Extension>
					<StartingPath>data</StartingPath>
					<ShowPreload>False</ShowPreload>
					</Element>
				<Element>
					<Name>Cloth_Sim_Filename</Name>
					<Type>Filename</Type>
					<Display_Name>Cloth Sim Info</Display_Name>
					<Required>false</Required>
					<Extension>simx</Extension>
					<StartingPath>data</StartingPath>
					<ShowPreload>True</ShowPreload>
					</Element>
				<Element>
					<Name>Cutscene_Only</Name>
					<Type>Selection</Type>
					<Display_Name>Cutscene Only</Display_Name>
					<Description>Yes if the morph is used for cutscenes only.</Description>
					<Default>no</Default>
					<Choice>no</Choice>
					<Choice>yes</Choice>
					</Element>
				<Element>
					<Name>VID_List</Name>
					<Type>String</Type>
					<Display_Name>VIDs</Display_Name>
					<Description>List of VIDs that are on for this mesh.</Description>
					<Required>false</Required>
					</Element>
				<Element>
					<Name>Obscured_VIDs</Name>
					<Type>Grid</Type>
					<Display_Name>Obscured VIDs</Display_Name>
					<Element>
						<Name>Obscured_VID</Name>
						<Type>Element</Type>
						<Display_Name>Obscured VID</Display_Name>
						<Element>
							<Name>VID</Name>
							<Type>Int</Type>
							<Default>1</Default>
							</Element>
						</Element>
					<Num_Display_Rows>8</Num_Display_Rows>
					</Element>
				<Element>
					<Name>Obscured_slots</Name>
					<Type>Grid</Type>
					<Display_Name>Obscured Slots</Display_Name>
					<Element>
						<Name>Obscured_slot</Name>
						<Type>Element</Type>
						<Display_Name>Obscured Slot</Display_Name>
						<Element>
							<Name>Slot</Name>
							<Type>Reference</Type>
							<Display_Name>Slot Name</Display_Name>
							<Reference>
								<File>customization_slots.xtbl</File>
								<Type>Slot.Name</Type>
								<OpenSeparate>False</OpenSeparate>
								</Reference>
							</Element>
						</Element>
					<Num_Display_Rows>8</Num_Display_Rows>
					</Element>
				<Element>
					<Name>Texture_Infos</Name>
					<Type>Grid</Type>
					<Display_Name>Textures</Display_Name>
					<Element>
						<Name>Texture_Info</Name>
						<Type>Element</Type>
						<Display_Name>Texture</Display_Name>
						<Element>
							<Name>Material_Name</Name>
							<Type>String</Type>
							<Display_Name>Material Name</Display_Name>
							<Required>false</Required>
							</Element>
						<Element>
							<Name>Variable_Name</Name>
							<Type>String</Type>
							<Display_Name>Variable Name</Display_Name>
							<Required>false</Required>
							</Element>
						<Element>
							<Name>Bitmap_Name</Name>
							<Type>String</Type>
							<Display_Name>Bitmap Name</Display_Name>
							</Element>
						</Element>
					<Num_Display_Rows>40</Num_Display_Rows>
					</Element>
				</Element>
			</Element>
		<Num_Display_Rows>14</Num_Display_Rows>
		</Element>
	<Element>
		<Name>Variants</Name>
		<Type>Grid</Type>
		<Element>
			<Name>Variant</Name>
			<Type>Element</Type>
			<Element>
				<Name>Name</Name>
				<Type>Reference</Type>
				<Description>Name of the variant.</Description>
				<Reference>
					<File>localized_exports\CustVar.xtbl</File>
					<Type>CustVar_Identifier.Name</Type>
					<OpenSeparate>False</OpenSeparate>
					</Reference>
				</Element>
			<Element>
				<Name>Price</Name>
				<Type>Float</Type>
