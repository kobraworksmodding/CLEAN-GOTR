					<Default>0</Default>
					</Element>
				<Element>
					<Name>Material_List</Name>
					<Type>Grid</Type>
					<Display_Name>Material List</Display_Name>
					<Description>List of materials present for this variant.</Description>
					<Element>
						<Name>Material_Element</Name>
						<Type>Element</Type>
						<Element>
							<Name>Material</Name>
